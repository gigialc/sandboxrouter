{
  "name": "@sandboxrouter/sdk",
  "version": "0.1.0",
  "description": "One API for every sandbox provider: route AI agents' code by price, speed or capability, with automatic fallback. Free and open source.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "sandboxrouter": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build && npm test",
    "test:py": "python3 -m unittest discover -s python/tests -v",
    "site:data": "node --import tsx scripts/site-data.ts"
  },
  "keywords": [
    "ai-agents",
    "blaxel",
    "cloudflare",
    "code-execution",
    "daytona",
    "docker",
    "e2b",
    "fly-sprites",
    "hopx",
    "maritime",
    "modal",
    "morph",
    "northflank",
    "openrouter",
    "router",
    "runloop",
    "sandbox",
    "tensorlake",
    "vercel-sandbox"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@blaxel/core": ">=0.3",
    "@daytonaio/sdk": ">=0.200",
    "@fly/sprites": ">=0.2",
    "@runloop/api-client": ">=3",
    "@tensorlakeai/tensorlake": ">=0.5",
    "@vercel/sandbox": ">=3",
    "e2b": ">=2",
    "modal": ">=0.11",
    "morphcloud": ">=0.0.20",
    "@hopx-ai/sdk": ">=0.5",
    "@northflank/js-client": ">=0.12"
  },
  "peerDependenciesMeta": {
    "e2b": {
      "optional": true
    },
    "@daytonaio/sdk": {
      "optional": true
    },
    "modal": {
      "optional": true
    },
    "@vercel/sandbox": {
      "optional": true
    },
    "morphcloud": {
      "optional": true
    },
    "@fly/sprites": {
      "optional": true
    },
    "@blaxel/core": {
      "optional": true
    },
    "@tensorlakeai/tensorlake": {
      "optional": true
    },
    "@runloop/api-client": {
      "optional": true
    },
    "@hopx-ai/sdk": {
      "optional": true
    },
    "@northflank/js-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@blaxel/core": "^0.3.34",
    "@daytonaio/sdk": "^0.227.3",
    "@fly/sprites": "^0.2.4",
    "@hopx-ai/sdk": "^0.5.1",
    "@northflank/js-client": "^0.12.0",
    "@runloop/api-client": "^3.0.0",
    "@tensorlakeai/tensorlake": "^0.5.161",
    "@types/node": "^26.6.6",
    "@vercel/sandbox": "^3.9.1",
    "e2b": "^2.63.0",
    "modal": "^0.11.1",
    "morphcloud": "^0.0.20",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gigialc/sandboxrouter.git"
  },
  "homepage": "https://sandboxrouter.vercel.app"
}
