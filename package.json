{
  "name": "@sandboxrouter/sdk",
  "version": "0.3.5",
  "description": "One API for every sandbox provider: route AI agents' code by price, speed or capability, with automatic fallback. Free and open source.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "sandboxrouter": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build && npm test",
    "test:py": "python3 -m unittest discover -s python/tests -v",
    "site:data": "node --import tsx scripts/site-data.ts",
    "price:check": "node --import tsx scripts/price-watch.ts",
    "secrets:push": "node --import tsx scripts/push-secrets.ts",
    "results:check": "node --import tsx scripts/validate-results.ts"
  },
  "keywords": [
    "ai-agents",
    "alibaba-cloud",
    "android",
    "aws-lambda",
    "azure-container-apps",
    "beam",
    "bedrock-agentcore",
    "blaxel",
    "cloudflare",
