    "router",
    "runloop",
    "sandbox",
    "tensorlake",
    "upstash",
    "vercel-sandbox"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@blaxel/core": ">=0.3",
